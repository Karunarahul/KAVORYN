# ==============================================================================
# KAVORYN — Environment Variables Template (.env.example)
# ==============================================================================

# --- Frontend (Vite Client) — Placed in .env.local ---
VITE_CONVEX_URL=https://resolute-bison-903.convex.cloud
VITE_CONVEX_SITE_URL=https://resolute-bison-903.convex.site
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder

# Local Convex CLI Target
CONVEX_DEPLOYMENT=dev:resolute-bison-903

# --- Backend (Convex Cloud) — Configured exclusively via `npx convex env set` ---
# CRITICAL: DO NOT store these in .env.local or frontend bundles!
# RAZORPAY_KEY_ID=rzp_test_placeholder
# RAZORPAY_KEY_SECRET=placeholder_secret
# RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
# CLERK_JWT_ISSUER_DOMAIN=https://placeholder.clerk.accounts.dev
